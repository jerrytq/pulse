rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/moods/{dateId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validEntry() {
        let data = request.resource.data;
        return data.keys().hasAll(['date', 'score', 'updatedAt'])
          && data.keys().hasOnly(['date', 'score', 'updatedAt', 'note'])
          && (!('note' in data) || (data.note is string && data.note.size() <= 500))
          && data.date is string
          && dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.date == dateId
          && data.score is int
          && data.score >= 1 && data.score <= 5
          && data.updatedAt == request.time;
      }
      allow read: if isOwner();
      allow create, update: if isOwner() && validEntry();
      allow delete: if isOwner();
    }
  }
}
